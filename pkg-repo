#!/usr/bin/env python3
"""
pkg-repo - Repository client for the pkg package manager
"""

import argparse
import hashlib
import json
import re
import shutil
import urllib.request
import urllib.error
import sys
import os
import tempfile
import subprocess
from collections import defaultdict
from pathlib import Path
from typing import Dict, List, Optional

REPO_CONFIG = Path.home() / ".config/pkg/repositories.conf"
CACHE_DIR = Path.home() / ".cache/pkg"


class DependencyConflictError(Exception):
    """Raised when dependency resolution can't proceed safely: a missing
    package, a circular dependency, an already-installed package that
    doesn't satisfy a new constraint, or two requirements on the same
    package that no available version can satisfy simultaneously.

    The point of a distinct exception here is that every one of these is
    a case where auto-resolution refuses to guess - it surfaces the
    conflict and lets the person decide, rather than silently installing
    something that might not fit or upgrading/downgrading something
    already relied upon elsewhere.
    """
    pass


def _parse_version_tuple(version: str) -> Optional[tuple]:
    """Parse the leading dotted-numeric run of a version string into a
    tuple of ints, e.g. '5.4.8-amd64' -> (5, 4, 8). Returns None if the
    string doesn't start with a recognizable version number.

    Mirrors the parsing in `pkg`'s compare_versions - duplicated rather
    than shared since pkg-repo and pkg are separate standalone scripts,
    not a shared package today.
    """
    match = re.match(r'^\s*([0-9]+(?:\.[0-9]+)*)', version)
    if not match:
        return None
    return tuple(int(x) for x in match.group(1).split('.'))


def _version_sort_key(version: str) -> tuple:
    """Sort key for version strings; unparseable versions sort lowest."""
    parsed = _parse_version_tuple(version)
    return parsed if parsed is not None else (-1,)


def _version_satisfies(version: str, op: str, required: str) -> bool:
    """Check whether `version` satisfies `op required` (e.g. '>=', '1.0.0')."""
    v = _parse_version_tuple(version)
    r = _parse_version_tuple(required)
    if v is None or r is None:
        return False
    if op == '>=':
        return v >= r
    if op == '>':
        return v > r
    if op == '<=':
        return v <= r
    if op == '<':
        return v < r
    if op == '==':
        return v == r
    return False

class Repository:
    def __init__(self, url: str):
        self.url = url.rstrip('/')
        self.index = None
        # Normalized view regardless of index format:
        # { package_name: { version_str: entry_dict } }
        self._packages: Dict[str, Dict[str, Dict]] = {}
    
    def fetch_index(self) -> Dict:
        """Fetch and parse the repository index"""
        index_url = f"{self.url}/index.json"
        
        try:
            print(f"Fetching repository index from {index_url}...")
            with urllib.request.urlopen(index_url) as response:
                data = response.read()
                self.index = json.loads(data)
                self._packages = self._normalize_index(self.index)
                return self.index
        except urllib.error.URLError as e:
            print(f"Error: Could not fetch repository index: {e}")
            return None
        except json.JSONDecodeError as e:
            print(f"Error: Invalid repository index format: {e}")
            return None

    @staticmethod
    def _normalize_index(index: Dict) -> Dict[str, Dict[str, Dict]]:
        """Normalize either index format into { name: { version: entry } }.

        v1 (index['version'] == 1 or absent): packages[name] is itself a
        single entry with a 'version' key inside it.
        v2: packages[name] = {'versions': {version_str: entry, ...}}.
        """
        packages: Dict[str, Dict[str, Dict]] = {}
        for name, entry in index.get('packages', {}).items():
            if isinstance(entry, dict) and 'versions' in entry:
                packages[name] = dict(entry['versions'])
            else:
                version = entry.get('version', 'unknown')
                packages[name] = {version: entry}
        return packages

    def get_versions(self, package_name: str) -> Dict[str, Dict]:
        """Return {version_str: entry} for a package, fetching the index
        first if needed. Empty dict if the package isn't in this repo."""
        if self.index is None:
            if not self.fetch_index():
                return {}
        return self._packages.get(package_name, {})

    def search_package(self, query: str) -> List[Dict]:
        """Search for packages matching query. Returns one result per
        matching package, using its highest available version."""
        if self.index is None:
            if not self.fetch_index():
                return []
        
        results = []
        query_lower = query.lower()
        
        for pkg_name, versions in self._packages.items():
            if not versions:
                continue
            latest = max(versions.keys(), key=_version_sort_key)
            info = versions[latest]
            if (query_lower in pkg_name.lower() or
                    query_lower in info.get('description', '').lower()):
                entry = dict(info)
                entry['name'] = pkg_name
                entry['version'] = latest
                results.append(entry)
        
        return results
    
    def get_package_info(self, package_name: str) -> Optional[Dict]:
        """Get information about a specific package's highest available
        version. Kept for callers (like `info`/`search`) that just want
        'the' version rather than choosing among several."""
        versions = self.get_versions(package_name)
        if not versions:
            return None
        latest = max(versions.keys(), key=_version_sort_key)
        entry = dict(versions[latest])
        entry['version'] = latest
        return entry
    
    @staticmethod
    def _sha256sum(path: Path) -> str:
        """Compute the sha256 checksum of a file on disk."""
        sha256 = hashlib.sha256()
        with open(path, 'rb') as f:
            while chunk := f.read(65536):
                sha256.update(chunk)
        return sha256.hexdigest()

    def download_package(self, package_name: str, destination: Path, version: str = None) -> bool:
        """Download a specific version of a package (the highest
        available version, if none is specified) and verify it against
        the checksum published in the repository index before it's
        handed off to `pkg` for installation.

        The file is downloaded to a temp file next to `destination` and
        only moved into place after the checksum matches, so a corrupted
        or tampered download can never end up at `destination` for `pkg
        -i` to pick up.
        """
        versions = self.get_versions(package_name)
        if not versions:
            print(f"Error: Package '{package_name}' not found in repository")
            return False

        if version is None:
            version = max(versions.keys(), key=_version_sort_key)
        pkg_info = versions.get(version)
        if not pkg_info:
            print(f"Error: Version {version} of '{package_name}' not found in repository "
                  f"(available: {', '.join(sorted(versions.keys())) or 'none'})")
            return False

        filename = pkg_info.get('filename')
        if not filename:
            print(f"Error: Repository index entry for '{package_name}' {version} is missing a filename")
            return False

        pkg_url = f"{self.url}/{filename}"
        expected_sha256 = pkg_info.get('sha256sum')

        if not expected_sha256:
            print(f"Warning: Repository index has no sha256sum for '{package_name}' {version}; "
                  f"the download cannot be verified and integrity is not guaranteed")

        destination.parent.mkdir(parents=True, exist_ok=True)
        tmp_fd, tmp_name = tempfile.mkstemp(
            dir=str(destination.parent), prefix=f".{filename}.", suffix=".part"
        )
        os.close(tmp_fd)
        tmp_path = Path(tmp_name)

        try:
            print(f"Downloading {package_name} {version}...")

            # Create progress indicator
            def reporthook(blocknum, blocksize, totalsize):
                if totalsize > 0:
                    percent = min(blocknum * blocksize * 100 / totalsize, 100)
                    print(f"\rProgress: {percent:.1f}%", end='', flush=True)

            urllib.request.urlretrieve(pkg_url, tmp_path, reporthook)
            print()  # New line after progress

            if expected_sha256:
                actual_sha256 = self._sha256sum(tmp_path)
                if actual_sha256.lower() != expected_sha256.strip().lower():
                    print(f"Error: Checksum mismatch for '{package_name}' {version}")
                    print(f"  Expected (index): {expected_sha256}")
                    print(f"  Actual (download): {actual_sha256}")
                    print("Refusing to install: the downloaded file does not match "
                          "the repository index. This could mean a corrupted "
                          "download, a stale index, or a tampered package.")
                    tmp_path.unlink(missing_ok=True)
                    return False
                print(f"Checksum verified (sha256: {actual_sha256[:16]}...)")

            shutil.move(str(tmp_path), str(destination))
            return True
        except urllib.error.URLError as e:
            print(f"\nError: Could not download package: {e}")
            tmp_path.unlink(missing_ok=True)
            return False
        except Exception as e:
            print(f"\nError: Download failed: {e}")
            tmp_path.unlink(missing_ok=True)
            return False

class RepositoryManager:
    def __init__(self):
        self.repos = []
        self.load_config()
    
    def load_config(self):
        """Load repository configuration"""
        if REPO_CONFIG.exists():
            with open(REPO_CONFIG) as f:
                for line in f:
                    line = line.strip()
                    if line and not line.startswith('#'):
                        self.repos.append(Repository(line))
        
        # Add default if no repos configured
        if not self.repos:
            print("No repositories configured. Add one with: pkg-repo repo add <URL>", file=sys.stderr)
    
    def save_config(self):
        """Save repository configuration"""
        REPO_CONFIG.parent.mkdir(parents=True, exist_ok=True)
        with open(REPO_CONFIG, 'w') as f:
            f.write("# pkg repository configuration\n")
            f.write("# One repository URL per line\n\n")
            for repo in self.repos:
                f.write(f"{repo.url}\n")
    
    def add_repository(self, url: str):
        """Add a new repository"""
        repo = Repository(url)
        # Test if repository is accessible
        if repo.fetch_index():
            self.repos.append(repo)
            self.save_config()
            print(f"Repository added: {url}")
            return True
        else:
            print(f"Error: Could not access repository at {url}")
            return False
    
    def remove_repository(self, url: str):
        """Remove a repository"""
        self.repos = [r for r in self.repos if r.url != url]
        self.save_config()
        print(f"Repository removed: {url}")
    
    def list_repositories(self):
        """List configured repositories"""
        if not self.repos:
            print("No repositories configured")
            return
        
        print("Configured repositories:")
        for repo in self.repos:
            print(f"  {repo.url}")
    
    def search_all(self, query: str) -> List[Dict]:
        """Search all repositories"""
        results = []
        for repo in self.repos:
            repo_results = repo.search_package(query)
            for result in repo_results:
                result['repository'] = repo.url
                results.append(result)
        return results
    
    def _get_installed_version(self, package_name: str) -> Optional[str]:
        """Return the installed version of a package (via `pkg -s`), or
        None if it isn't installed / can't be determined."""
        try:
            result = subprocess.run(
                ['pkg', '-s', package_name],
                capture_output=True, text=True
            )
        except FileNotFoundError:
            print("Warning: 'pkg' not found on PATH; cannot check installed packages")
            return None
        if result.returncode != 0:
            return None
        for line in result.stdout.splitlines():
            if line.startswith('Version:'):
                return line.split(':', 1)[1].strip()
        return None

    def _all_versions_across_repos(self, package_name: str) -> Dict[str, tuple]:
        """Merge every version of a package available across all
        configured repos into { version_str: (repo, entry) }. When two
        repos offer the same version, the first configured repo wins."""
        merged: Dict[str, tuple] = {}
        for repo in self.repos:
            for version, entry in repo.get_versions(package_name).items():
                if version not in merged:
                    merged[version] = (repo, entry)
        return merged

    @staticmethod
    def _parse_depends(depends: str):
        """Split a 'depends' metadata string into (name, op, version)
        tuples. op/version are None when a dependency has no version
        constraint (e.g. plain 'libsyscalls' rather than
        'libsyscalls >= 1.0.0')."""
        deps = []
        for dep in depends.split(','):
            dep = dep.strip()
            if not dep:
                continue
            parts = dep.split()
            name = parts[0]
            if len(parts) >= 3:
                deps.append((name, parts[1], parts[2]))
            else:
                deps.append((name, None, None))
        return deps

    def _build_dependency_plan(self, root_name: str):
        """Walk the dependency tree rooted at root_name and return an
        ordered install plan (dependencies before dependents).

        Design notes / known limitation: a package's `depends` can differ
        between versions, but which version we'll end up installing isn't
        known until constraints are resolved - and constraints can't be
        gathered without walking `depends`. Rather than a full
        backtracking solver, this walks each package's *highest available*
        version's `depends` to discover the graph, then separately picks
        the actual version to install as the highest one that satisfies
        every constraint collected. For a repo that only ever has one or
        two versions of a given package, this covers the real case; a
        package pinned to a much older version than the latest could in
        principle have a `depends` list this doesn't see. That's a
        deliberate scope cut, not an oversight - flagging it because it's
        the kind of thing that matters if this repo ever hosts many
        divergent versions of the same package.

        Raises DependencyConflictError on missing packages, circular
        dependencies, an already-installed package that no longer
        satisfies a newly-required constraint, or a set of constraints
        no available version can simultaneously satisfy.
        """
        constraints: Dict[str, list] = defaultdict(list)  # name -> [(op, version, required_by), ...]
        available: Dict[str, Dict[str, tuple]] = {}       # name -> {version: (repo, entry)}
        order: list = []                                  # dependency-first package name order
        visited: set = set()
        chain: list = []

        def visit(name: str):
            if name in chain:
                cycle = ' -> '.join(chain[chain.index(name):] + [name])
                raise DependencyConflictError(f"circular dependency detected: {cycle}")
            if name in visited:
                return
            chain.append(name)

            versions = self._all_versions_across_repos(name)
            if not versions:
                reqs = constraints.get(name)
                req_note = f" (required by {reqs[-1][2]})" if reqs else ""
                raise DependencyConflictError(
                    f"package '{name}' not found in any configured repository{req_note}"
                )
            available[name] = versions

            newest = max(versions.keys(), key=_version_sort_key)
            _, newest_entry = versions[newest]
            depends = newest_entry.get('depends', '')
            for dep_name, op, dep_version in self._parse_depends(depends):
                if op and dep_version:
                    constraints[dep_name].append((op, dep_version, name))
                visit(dep_name)

            chain.pop()
            visited.add(name)
            order.append(name)

        visit(root_name)
        return order, available, constraints

    def _resolve_install_plan(self, root_name: str, force: bool):
        """Turn a dependency graph into a concrete, safe install plan.

        For each package (dependencies first): if it's already installed,
        the install is only allowed to proceed if the installed version
        satisfies every constraint gathered for it - auto-resolution never
        upgrades or downgrades an already-installed dependency on its own,
        since that could break whatever already depends on the version
        that's there. If it's not installed, the highest available version
        that satisfies every constraint is selected; if none does, that's
        a conflict and resolution stops with a clear explanation rather
        than guessing.
        """
        order, available, constraints = self._build_dependency_plan(root_name)

        plan = []  # list of (name, version, repo, entry, needs_install)
        for name in order:
            reqs = constraints.get(name, [])
            installed_version = self._get_installed_version(name)

            if installed_version is not None and not (name == root_name and force):
                unmet = [r for r in reqs if not _version_satisfies(installed_version, r[0], r[1])]
                if unmet:
                    lines = [f"  - {req_by} requires {name} {op} {ver}" for op, ver, req_by in unmet]
                    raise DependencyConflictError(
                        f"'{name}' is installed at version {installed_version}, which does not satisfy:\n"
                        + "\n".join(lines) +
                        f"\nAuto-resolution will not upgrade or downgrade an already-installed "
                        f"package, since something else may depend on the version that's there. "
                        f"Resolve this manually, then retry."
                    )
                plan.append((name, installed_version, None, None, False))
                continue

            versions = available[name]
            candidates = sorted(versions.keys(), key=_version_sort_key, reverse=True)
            chosen = None
            for v in candidates:
                if all(_version_satisfies(v, op, ver) for op, ver, _ in reqs):
                    chosen = v
                    break

            if chosen is None:
                lines = [f"  - {req_by} requires {name} {op} {ver}" for op, ver, req_by in reqs]
                raise DependencyConflictError(
                    f"no available version of '{name}' satisfies all requirements:\n"
                    + "\n".join(lines) +
                    f"\n  available version(s): {', '.join(candidates) if candidates else '(none)'}"
                )

            repo, entry = versions[chosen]
            plan.append((name, chosen, repo, entry, True))

        return plan

    def install_package(self, package_name: str, force: bool = False):
        """Install a package from repository, automatically resolving and
        installing any missing dependencies. Refuses (with a clear error)
        rather than guessing when dependencies conflict, are missing, or
        an already-installed package doesn't satisfy a new requirement."""
        try:
            plan = self._resolve_install_plan(package_name, force)
        except DependencyConflictError as e:
            print(f"Error: {e}")
            return False

        CACHE_DIR.mkdir(parents=True, exist_ok=True)

        for name, version, repo, entry, needs_install in plan:
            if not needs_install:
                print(f"Dependency already satisfied: {name} {version}")
                continue

            label = "Installing" if name == package_name else "Resolving dependency"
            print(f"{label}: {name} {version}")

            filename = entry.get('filename')
            if not filename:
                print(f"Error: Repository index entry for '{name}' {version} is missing a filename")
                return False

            pkg_file = CACHE_DIR / filename
            if not repo.download_package(name, pkg_file, version=version):
                print(f"Error: could not download '{name}' {version}")
                return False

            cmd = ['sudo', 'pkg', '-i', str(pkg_file)]
            if force and name == package_name:
                cmd.append('--force')

            result = subprocess.run(cmd)
            if result.returncode != 0:
                print(f"Error: installation of '{name}' failed")
                return False
            print(f"Successfully installed {name}")

        return True

def cmd_update(args):
    """Update repository indices"""
    mgr = RepositoryManager()
    
    print("Updating repository indices...")
    for repo in mgr.repos:
        if repo.fetch_index():
            pkg_count = len(repo.index.get('packages', {}))
            print(f"  {repo.url}: {pkg_count} packages")
    
    return 0

def cmd_search(args):
    """Search for packages"""
    mgr = RepositoryManager()
    results = mgr.search_all(args.query)
    
    if not results:
        print(f"No packages found matching '{args.query}'")
        return 1
    
    print(f"Found {len(results)} package(s):\n")
    
    for pkg in results:
        print(f"{pkg['name']} - {pkg['version']}")
        if 'description' in pkg:
            print(f"  {pkg['description']}")
        if 'repository' in pkg:
            print(f"  Repository: {pkg['repository']}")
        print()
    
    return 0

def cmd_install(args):
    """Install packages from repository"""
    mgr = RepositoryManager()
    
    failed = []
    for package in args.packages:
        if not mgr.install_package(package, args.force):
            failed.append(package)
    
    if failed:
        print(f"\nFailed to install: {', '.join(failed)}")
        return 1
    
    return 0

def cmd_info(args):
    """Show package information"""
    mgr = RepositoryManager()
    
    for repo in mgr.repos:
        versions = repo.get_versions(args.package)
        if versions:
            print(f"Package: {args.package}")
            print(f"Repository: {repo.url}")
            sorted_versions = sorted(versions.keys(), key=_version_sort_key, reverse=True)
            print(f"Available versions: {', '.join(sorted_versions)}")

            latest = sorted_versions[0]
            pkg_info = versions[latest]
            print(f"\nLatest version: {latest}")
            if 'description' in pkg_info:
                print(f"Description: {pkg_info['description']}")
            if 'author' in pkg_info:
                print(f"Author: {pkg_info['author']}")
            if 'license' in pkg_info:
                print(f"License: {pkg_info['license']}")
            if 'depends' in pkg_info:
                print(f"Dependencies: {pkg_info['depends']}")
            if 'size' in pkg_info:
                print(f"Size: {pkg_info['size']} bytes")
            
            return 0
    
    print(f"Error: Package '{args.package}' not found")
    return 1

def cmd_repo_list(args):
    """List repositories"""
    mgr = RepositoryManager()
    mgr.list_repositories()
    return 0

def cmd_repo_add(args):
    """Add repository"""
    mgr = RepositoryManager()
    return 0 if mgr.add_repository(args.url) else 1

def cmd_repo_remove(args):
    """Remove repository"""
    mgr = RepositoryManager()
    mgr.remove_repository(args.url)
    return 0

def main():
    parser = argparse.ArgumentParser(
        description="pkg-repo - Repository client for pkg package manager"
    )
    
    subparsers = parser.add_subparsers(dest='command', help='Commands')
    
    # update command
    parser_update = subparsers.add_parser('update', help='Update repository indices')
    parser_update.set_defaults(func=cmd_update)
    
    # search command
    parser_search = subparsers.add_parser('search', help='Search for packages')
    parser_search.add_argument('query', help='Search query')
    parser_search.set_defaults(func=cmd_search)
    
    # install command
    parser_install = subparsers.add_parser('install', help='Install packages')
    parser_install.add_argument('packages', nargs='+', help='Package names to install')
    parser_install.add_argument('--force', action='store_true', help='Force reinstall')
    parser_install.set_defaults(func=cmd_install)
    
    # info command
    parser_info = subparsers.add_parser('info', help='Show package information')
    parser_info.add_argument('package', help='Package name')
    parser_info.set_defaults(func=cmd_info)
    
    # repo commands
    parser_repo = subparsers.add_parser('repo', help='Manage repositories')
    repo_subparsers = parser_repo.add_subparsers(dest='repo_command')
    
    repo_list = repo_subparsers.add_parser('list', help='List repositories')
    repo_list.set_defaults(func=cmd_repo_list)
    
    repo_add = repo_subparsers.add_parser('add', help='Add repository')
    repo_add.add_argument('url', help='Repository URL')
    repo_add.set_defaults(func=cmd_repo_add)
    
    repo_remove = repo_subparsers.add_parser('remove', help='Remove repository')
    repo_remove.add_argument('url', help='Repository URL')
    repo_remove.set_defaults(func=cmd_repo_remove)
    
    args = parser.parse_args()
    
    if hasattr(args, 'func'):
        return args.func(args)
    else:
        parser.print_help()
        return 1

if __name__ == '__main__':
    sys.exit(main())
